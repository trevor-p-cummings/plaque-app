# ── Client-side (bundled into the Expo app) ──────────────────
# Find these in your Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# ── Server-side (Supabase Edge Function secrets) ─────────────
# These are NOT read from .env — set them via the Supabase CLI:
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# OPENAI_API_KEY  — used by the generate-narrative edge function
